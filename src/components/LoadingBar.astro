---
---

<div
  id="loading-cup"
  class="bg-background fixed inset-0 z-[60] opacity-0"
  transition:persist
  transition:name="loading-cup"
  hidden
>
  <div class="flex size-full flex-col items-center justify-center">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-accent size-16"
    >
      <defs>
        <clipPath id="cup-clip">
          <path d="M4.5 7h11v7a4 4 0 0 1-4 4h-3a4 4 0 0 1-4-4V7z" />
        </clipPath>
      </defs>

      <rect
        id="cup-liquid"
        x="4.5"
        y="7"
        width="11"
        height="11"
        fill="currentColor"
        stroke="none"
        clip-path="url(#cup-clip)"
        style="clip-path: url(#cup-clip); transform-origin: 10px 18px;"
      />

      <path d="M4.5 7h11v7a4 4 0 0 1-4 4h-3a4 4 0 0 1-4-4V7z" />
      <path d="M15.5 9.5h1.5a2 2 0 0 1 0 4h-1.5" />
      <path d="M8 2.5c0 .8.8.8.8 1.6S8 5.7 8 6.5" />
      <path d="M11.5 2.5c0 .8.8.8.8 1.6s-.8 1.6-.8 2.4" />
    </svg>
    <p
      id="loading-cup-message"
      class="mt-3 text-sm opacity-0 transition-opacity duration-500"
    >
      Warming up a cold cache, hang tight...
    </p>
  </div>
</div>

<script is:inline>
  (function () {
    // Guard against re-registering listeners: this script tag isn't
    // transition:persist, so it re-executes on every soft navigation.
    // Without this guard, listeners would stack up across navigations.
    if (window.__loadingCupInit) return;
    window.__loadingCupInit = true;

    let fadeOutTimer;
    let messageTimer;

    function els() {
      const wrap = document.getElementById("loading-cup");
      const liquid = document.getElementById("cup-liquid");
      const message = document.getElementById("loading-cup-message");
      return wrap && liquid && message ? { wrap, liquid, message } : null;
    }

    function setFill(el, fraction, durationMs) {
      // fraction: 0 = empty, 1 = full. The liquid rect is scaled vertically
      // from its bottom edge to simulate rising coffee.
      el.style.transition = `transform ${durationMs}ms cubic-bezier(0.1, 0.7, 0.3, 1)`;
      el.style.transform = `scaleY(${fraction})`;
    }

    function onFadeOutEnd(event) {
      if (event.target !== event.currentTarget || event.propertyName !== "opacity")
        return;
      const e = els();
      if (e && e.wrap.style.opacity === "0") {
        e.wrap.hidden = true;
        e.liquid.style.transition = "none";
        e.liquid.style.transform = "scaleY(0)";
      }
    }

    function start() {
      const e = els();
      if (!e) return;
      clearTimeout(fadeOutTimer);
      clearTimeout(messageTimer);
      e.wrap.removeEventListener("transitionend", onFadeOutEnd);
      e.wrap.hidden = false;
      e.wrap.style.transition = "none";
      e.wrap.style.opacity = "0";
      // Force reflow so the opacity transition below actually animates.
      void e.wrap.offsetWidth;
      e.wrap.style.transition = "opacity 120ms ease-out";
      e.wrap.style.opacity = "1";
      e.liquid.style.transition = "none";
      e.liquid.style.transform = "scaleY(0)";
      void e.liquid.offsetWidth;
      setFill(e.liquid, 0.8, 4000);
      e.message.style.opacity = "0";
      // Only show the reassurance message if loading is taking a while;
      // most navigations finish well before this and never see it.
      messageTimer = setTimeout(() => {
        e.message.style.opacity = "0.7";
      }, 2000);
    }

    function finish() {
      const e = els();
      if (!e || e.wrap.hidden) return;
      clearTimeout(messageTimer);
      e.message.style.opacity = "0";
      setFill(e.liquid, 1, 200);
      clearTimeout(fadeOutTimer);
      fadeOutTimer = setTimeout(() => {
        e.wrap.addEventListener("transitionend", onFadeOutEnd);
        e.wrap.style.transition = "opacity 250ms ease-out";
        e.wrap.style.opacity = "0";
        // Fallback in case transitionend doesn't fire for some reason
        // (e.g. the tab was backgrounded), so the overlay can't get stuck.
        setTimeout(() => onFadeOutEnd({ target: e.wrap, currentTarget: e.wrap, propertyName: "opacity" }), 400);
      }, 200);
    }

    document.addEventListener("astro:before-preparation", start);
    document.addEventListener("astro:page-load", finish);
  })();
</script>
