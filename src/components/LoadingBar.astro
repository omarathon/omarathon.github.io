---
---

<div
  id="loading-cup"
  class="bg-background pointer-events-none fixed inset-0 z-[100] flex items-center justify-center opacity-0"
  transition:persist
  transition:name="loading-cup"
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-accent size-16"
  >
    <defs>
      <clipPath id="cup-clip">
        <path d="M4.5 7h11v7a4 4 0 0 1-4 4h-3a4 4 0 0 1-4-4V7z" />
      </clipPath>
    </defs>

    <rect
      id="cup-liquid"
      x="4.5"
      y="7"
      width="11"
      height="11"
      fill="currentColor"
      stroke="none"
      clip-path="url(#cup-clip)"
      style="clip-path: url(#cup-clip); transform-origin: 10px 18px;"
    />

    <path d="M4.5 7h11v7a4 4 0 0 1-4 4h-3a4 4 0 0 1-4-4V7z" />
    <path d="M15.5 9.5h1.5a2 2 0 0 1 0 4h-1.5" />
    <path d="M8 2.5c0 .8.8.8.8 1.6S8 5.7 8 6.5" />
    <path d="M11.5 2.5c0 .8.8.8.8 1.6s-.8 1.6-.8 2.4" />
  </svg>
</div>

<script is:inline>
  (function () {
    let hideTimer;

    function els() {
      const wrap = document.getElementById("loading-cup");
      const liquid = document.getElementById("cup-liquid");
      return wrap && liquid ? { wrap, liquid } : null;
    }

    function setFill(el, fraction, durationMs) {
      // fraction: 0 = empty, 1 = full. The liquid rect is scaled vertically
      // from its bottom edge to simulate rising coffee.
      el.style.transition = `transform ${durationMs}ms cubic-bezier(0.1, 0.7, 0.3, 1)`;
      el.style.transform = `scaleY(${fraction})`;
    }

    function start() {
      const e = els();
      if (!e) return;
      clearTimeout(hideTimer);
      e.wrap.style.transition = "opacity 120ms ease-out";
      e.wrap.style.opacity = "1";
      e.wrap.style.pointerEvents = "auto";
      e.liquid.style.transition = "none";
      e.liquid.style.transform = "scaleY(0)";
      // Force reflow so the next transform change actually animates.
      void e.liquid.offsetWidth;
      setFill(e.liquid, 0.8, 4000);
    }

    function finish() {
      const e = els();
      if (!e) return;
      setFill(e.liquid, 1, 200);
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => {
        e.wrap.style.transition = "opacity 250ms ease-out";
        e.wrap.style.opacity = "0";
        e.wrap.style.pointerEvents = "none";
        hideTimer = setTimeout(() => {
          e.liquid.style.transition = "none";
          e.liquid.style.transform = "scaleY(0)";
        }, 250);
      }, 200);
    }

    document.addEventListener("astro:before-preparation", start);
    document.addEventListener("astro:page-load", finish);
  })();
</script>
