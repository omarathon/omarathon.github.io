---
import type { CollectionEntry } from "astro:content";
import LinkButton from "@/components/LinkButton.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  project: CollectionEntry<"projects">;
  variant?: "featured" | "compact";
};

const { project, variant = "compact" } = Astro.props;
const { title, description, bullets, tags, links, image, active } =
  project.data;
const isFeatured = variant === "featured";
---

<li
  id={project.id}
  data-tags={tags.join(",")}
  class="border-border scroll-mt-24 border-b pb-8 last:border-none"
>
  {
    image && (
      <img
        src={getAssetPath(image)}
        alt={title}
        loading="lazy"
        decoding="async"
        class="mb-3 max-h-72 w-full rounded object-cover"
      />
    )
  }
  <h3 class:list={[isFeatured ? "text-accent text-lg" : "", "font-medium"]}>
    {title}
    {
      active && (
        <span class="border-accent text-accent ms-2 inline-flex items-center gap-1 rounded-full border px-2 py-0.5 align-middle text-xs font-normal">
          <span class="bg-accent inline-block size-1.5 rounded-full" />
          Active
        </span>
      )
    }
  </h3>
  <p class:list={["mt-1", isFeatured ? "" : "text-sm opacity-90"]}>
    {description}
  </p>
  {
    bullets && (
      <ul class="[&_a]:text-accent mt-2 list-disc space-y-1 ps-5 text-sm opacity-90 [&_a]:underline [&_a]:decoration-dashed [&_a]:underline-offset-4 [&_a]:hover:no-underline">
        {bullets.map(bullet => (
          <li set:html={bullet} />
        ))}
      </ul>
    )
  }
  <div class="mt-3 flex flex-wrap items-center gap-2">
    {
      tags.map(tag => (
        <span class="border-border rounded border px-2 py-0.5 text-xs opacity-80">
          {tag}
        </span>
      ))
    }
  </div>
  {
    links.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2 text-sm">
        {links.map(link => (
          <LinkButton
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border text-accent hover:border-accent rounded border px-2 py-1"
          >
            {link.label}
            {isFeatured && (
              <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
            )}
          </LinkButton>
        ))}
      </div>
    )
  }
</li>
