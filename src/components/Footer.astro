---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={[
    "app-layout relative z-[70]",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  transition:persist
  transition:name="site-footer"
  {...attrs}
>
  <div
    class="border-border flex items-center justify-center border-t py-6 sm:py-4"
  >
    <Socials />
  </div>
</footer>
