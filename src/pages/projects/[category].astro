---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TechFilter from "@/components/TechFilter.astro";
import { PROJECT_CATEGORIES } from "@/content.config";
import config from "@/config";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");

  return (
    Object.entries(PROJECT_CATEGORIES) as [
      keyof typeof PROJECT_CATEGORIES,
      string,
    ][]
  ).map(([key, label]) => ({
    params: { category: key },
    props: {
      label,
      projects: allProjects
        .filter(p => p.data.category === key)
        .sort(
          (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
            a.data.order - b.data.order
        ),
    },
  }));
}

const { label, projects } = Astro.props;
---

<Layout
  title={`${label} | ${config.site.title}`}
  description={`${label}, by Omar Tanner.`}
>
  <Header />
  <Main pageTitle={label}>
    <TechFilter projects={projects} targetId="project-list" />
    <ul id="project-list" class="flex flex-col gap-8">
      {projects.map(project => <ProjectCard project={project} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
