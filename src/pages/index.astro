---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const about = await getEntry("pages", "about");
if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}
const { Content: AboutContent } = await render(about);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class:list={[
        "pt-8 pb-6",
        { "border-border border-b": sortedPosts.length > 0 },
      ]}
    >
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Omar's corner
      </h1>

      <div class="app-prose max-w-none">
        <img
          id="profile-photo"
          src={getAssetPath("/images/profile.webp")}
          alt="Omar Tanner"
          class="not-prose float-left me-3 size-20 rounded-full object-cover grayscale transition-[filter] duration-500 sm:size-24"
        />
        <AboutContent />
      </div>

      <p class="mt-4">
        <LinkButton
          class="text-accent decoration-dashed underline-offset-4 hover:underline"
          href="/projects"
        >
          See my projects
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style is:global>
  .hover-preview {
    color: var(--color-foreground);
    text-decoration-line: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
  }

  @media (hover: hover) {
    .hover-preview:hover {
      color: var(--color-accent);
    }

    #profile-photo:hover {
      filter: grayscale(0);
    }
  }

  #profile-photo.is-saturated {
    filter: grayscale(0);
  }

  .hover-preview-float {
    position: fixed;
    z-index: 50;
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 12px rgb(0 0 0 / 25%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .hover-preview-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    background: rgb(0 0 0 / 60%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .hover-preview-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .hover-preview-overlay img {
    width: 100%;
    max-width: 24rem;
    max-height: 70vh;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
  }
</style>

<script>
  function warmHoverPreviewImages() {
    const previews =
      document.querySelectorAll<HTMLElement>(".hover-preview");
    previews.forEach(el => {
      const src = el.dataset.img;
      if (src) new Image().src = src;
    });
  }

  function setupHoverPreviews() {
    const canHover = window.matchMedia("(hover: hover)").matches;
    const previews =
      document.querySelectorAll<HTMLElement>(".hover-preview");

    if (!canHover) {
      document
        .querySelector<HTMLElement>("#profile-photo")
        ?.addEventListener("click", e => {
          (e.currentTarget as HTMLElement).classList.toggle("is-saturated");
        });
    }

    if (canHover) {
      const size = 160;
      const gap = 16;
      const margin = 8;

      const float = document.createElement("img");
      float.className = "hover-preview-float";
      document.body.appendChild(float);

      previews.forEach(el => {
        el.addEventListener("mouseenter", () => {
          float.src = el.dataset.img ?? "";
          float.style.opacity = "1";
        });
        el.addEventListener("mousemove", e => {
          let left = e.clientX + gap;
          if (left + size + margin > window.innerWidth) {
            left = e.clientX - gap - size;
          }
          left = Math.max(
            margin,
            Math.min(left, window.innerWidth - size - margin)
          );

          let top = e.clientY - gap - size;
          if (top < margin) {
            top = e.clientY + gap;
          }
          top = Math.max(
            margin,
            Math.min(top, window.innerHeight - size - margin)
          );

          float.style.left = `${left}px`;
          float.style.top = `${top}px`;
        });
        el.addEventListener("mouseleave", () => {
          float.style.opacity = "0";
        });
      });
    } else {
      const overlay = document.createElement("div");
      overlay.className = "hover-preview-overlay";
      const overlayImg = document.createElement("img");
      overlayImg.alt = "";
      overlay.appendChild(overlayImg);
      document.body.appendChild(overlay);

      let activeEl: HTMLElement | null = null;

      overlay.addEventListener("click", () => {
        overlay.classList.remove("is-visible");
        activeEl = null;
      });

      previews.forEach(el => {
        el.addEventListener("click", e => {
          e.stopPropagation();
          if (activeEl === el) {
            overlay.classList.remove("is-visible");
            activeEl = null;
          } else {
            overlayImg.src = el.dataset.img ?? "";
            overlay.classList.add("is-visible");
            activeEl = el;
          }
        });
      });
    }
  }

  document.addEventListener("astro:page-load", () => {
    setupHoverPreviews();
    if ("requestIdleCallback" in window) {
      requestIdleCallback(warmHoverPreviewImages);
    } else {
      setTimeout(warmHoverPreviewImages, 200);
    }
  });
</script>
