---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const about = await getEntry("pages", "about");
if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}
const { Content: AboutContent } = await render(about);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class:list={[
        "pt-8 pb-6",
        { "border-border border-b": sortedPosts.length > 0 },
      ]}
    >
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Omar's corner
      </h1>

      <div class="app-prose max-w-none">
        <img
          src={getAssetPath("/images/profile.webp")}
          alt="Omar Tanner"
          class="not-prose float-left me-3 size-24 rounded-full object-cover grayscale transition-[filter] duration-500 hover:grayscale-0"
        />
        <AboutContent />
      </div>

      <p class="mt-4">
        <LinkButton
          class="text-accent decoration-dashed underline-offset-4 hover:underline"
          href="/projects"
        >
          See my projects
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style is:global>
  .hover-preview {
    color: var(--color-foreground);
    text-decoration: underline dashed;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .hover-preview:hover {
    color: var(--color-accent);
  }

  .hover-preview-float {
    position: fixed;
    z-index: 50;
    width: 220px;
    max-height: 220px;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 12px rgb(0 0 0 / 25%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    transform: translateY(-100%);
  }

  .hover-preview-inline {
    display: block;
    width: 100%;
    max-width: 20rem;
    max-height: 14rem;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    margin-block: 0.5rem;
  }
</style>

<script>
  function setupHoverPreviews() {
    const canHover = window.matchMedia("(hover: hover)").matches;
    const previews =
      document.querySelectorAll<HTMLElement>(".hover-preview");

    if (canHover) {
      const float = document.createElement("img");
      float.className = "hover-preview-float";
      document.body.appendChild(float);

      previews.forEach(el => {
        el.addEventListener("mouseenter", () => {
          float.src = el.dataset.img ?? "";
          float.style.opacity = "1";
        });
        el.addEventListener("mousemove", e => {
          float.style.left = `${e.clientX + 16}px`;
          float.style.top = `${e.clientY - 16}px`;
        });
        el.addEventListener("mouseleave", () => {
          float.style.opacity = "0";
        });
      });
    } else {
      previews.forEach(el => {
        const img = document.createElement("img");
        img.className = "hover-preview-inline hidden";
        img.src = el.dataset.img ?? "";
        img.alt = "";
        el.insertAdjacentElement("afterend", img);

        el.addEventListener("click", () => {
          img.classList.toggle("hidden");
        });
      });
    }
  }

  document.addEventListener("astro:page-load", setupHoverPreviews);
</script>
